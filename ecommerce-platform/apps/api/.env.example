# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecommerce?schema=public"

NODE_ENV="development"
PORT=5000

# JWT signing secret for access tokens. REQUIRED in production, must be >= 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET="change-me-to-a-long-random-string"
ACCESS_TOKEN_EXPIRES_IN="15m"

# Comma-separated list of origins allowed to call this API in production, e.g.
# ALLOWED_ORIGINS="https://example.com,https://admin.example.com"
ALLOWED_ORIGINS=""
